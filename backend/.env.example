# Nusxa oling:  cp .env.example .env   — keyin kerakli qiymatlarni yozing.
# .env fayli git'ga qo'shilmaydi.

# --- AI provayder: gemini | claude | ollama | mock ---
# Bo'sh qolsa: GEMINI_API_KEY bo'lsa gemini, ANTHROPIC_API_KEY bo'lsa claude, aks holda ollama.
# Noma'lum qiymat jimgina almashtirilmaydi — ogohlantirish /api/status va Sozlamalarda ko'rinadi.
# mock — modelsiz, faqat oddiy buyruqlar (qoida asosida; testlar uchun).
XADICHA_PROVIDER=gemini

# --- Google Gemini (asosiy bulut AI) — https://aistudio.google.com/apikey ---
# Kalit FAQAT shu faylda (backend). Interfeysga, API javoblariga, loglarga va git'ga chiqmaydi.
GEMINI_API_KEY=
# Model (rasmiy "Stable" ro'yxati: https://ai.google.dev/gemini-api/docs/models). Bo'sh — gemini-3.8-flash.
# Eskirsa yoki mavjud bo'lmasa, /api/status aniq xabar beradi — shu yerda almashtiring.
GEMINI_MODEL=
# Asosiy model yiqilsa (5xx, timeout, 404, model limiti) — Ollama'dan oldin sinaladigan Gemini modellari (vergul bilan)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
# Fikrlash darajasi: low | medium | high | (bo'sh — model standarti). Desktop agent uchun low — tezroq.
GEMINI_THINKING=low
# Bitta so'rov uchun kutish (soniya); oshsa — keyingi model / Ollama
GEMINI_TIMEOUT=20
# Gemini ishlamasa: ollama (avtomatik zaxira) | none
XADICHA_FALLBACK=ollama

# --- Internet qidiruvi (Google Search grounding, faqat Gemini) ---
# auto   — faqat dolzarb / tashqi ma'lumot kerak savollarda (bugun, narx, yangilik, ob-havo, "eng so'nggi"...)
# always — har bir mos savolda (salomlashish, rahmat va h.k. bundan mustasno)
# never  — Google qidiruvsiz (aniq "X haqida qidir" buyrug'i bepul DuckDuckGo/Wikipedia orqali)
# Grounding ishlamasa (masalan, bepul tarifda 429) — avtomatik DuckDuckGo/Wikipedia ishlatiladi.
XADICHA_SEARCH_MODE=auto

# --- Nutqni aniqlash (STT): auto | gemini | whisper ---
# auto — Gemini Transcribe (kalit bo'lsa), ishlamasa Whisper; whisper — faqat lokal (internetsiz)
XADICHA_STT=auto
GEMINI_STT_MODEL=gemini-3.5-transcribe
# Buyruq rejimida oqimli STT (gapirayotganda jonli matn; gap tugagach ~0.7 s da yakuniy matn).
# Ishlamasa — avtomatik oddiy yo'l (yuqoridagi model yoki Whisper), audio yo'qolmaydi.
XADICHA_STT_STREAMING=1
GEMINI_STT_LIVE_MODEL=gemini-3.5-transcribe-live
# Maxsus lug'at + tuzatishlar (JSON). Bo'sh — backend/vocabulary.json (bo'lsa). Namuna: vocabulary.example.json
XADICHA_VOCABULARY=

# --- Gemini Live (real vaqtli ovozli suhbat) ---
GEMINI_LIVE=1
GEMINI_LIVE_MODEL=gemini-3.8-live
# Ovoz nomi (bo'sh — model standarti), masalan: Kore
GEMINI_LIVE_VOICE=

# Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Ollama — bepul lokal model:  https://ollama.com  →  ollama pull qwen3.5:9b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# --- Nutqni aniqlash (faster-whisper) ---
# tiny | base | small | medium | large-v3-turbo   (kattaroq = aniqroq, sekinroq)
WHISPER_MODEL=large-v3-turbo
# auto — Apple Silicon'da MLX (grafik protsessor, tezroq), aks holda faster-whisper; yoki: mlx | faster
STT_ENGINE=auto

# --- Ovoz (ayol ovozi) ---
# system — macOS "say" (en: Samantha, ru: Milena; o'zbekcha tizim ovozi yo'q)
# edge   — uz-UZ-MadinaNeural, ru-RU-SvetlanaNeural, en-US-JennyNeural (internet kerak)
TTS_ENGINE=edge
TTS_ENABLED=1
TTS_RATE=175
VOICE_UZ=
VOICE_RU=
VOICE_EN=

# --- Xavfsizlik ---
# Shu darajadan boshlab tasdiq so'raladi: low | medium | high
CONFIRM_RISK=medium
MAX_STEPS=12
MAX_RETRIES=2
# Fayl amallari ruxsat etilgan papka (standart: uy papkasi)
XADICHA_WORKSPACE=
